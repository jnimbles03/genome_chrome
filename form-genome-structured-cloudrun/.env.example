# Form Genome Project - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Configuration - Two-Tier Architecture
# =============================================================================
# The system uses a two-tier routing strategy:
# - Tier 1: Gemini Flash (fast, cheap, default)
# - Tier 2: Claude Sonnet (fallback for edge cases)

# Tier 1: Google Gemini API (Primary - Fast & Cheap)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Tier 2: Anthropic Claude API (Fallback - Higher Quality)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Fallback Configuration
ENABLE_LLM_FALLBACK=true
LLM_CONFIDENCE_THRESHOLD=0.7
LLM_COMPLEXITY_THRESHOLD=75

# Legacy Provider Support (Optional - Not recommended for new deployments)
# LLM_PROVIDER=gemini  # Options: gemini, anthropic, openai, xai
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini
# GROK_API_KEY=your_xai_key_here
# GROK_MODEL=grok-beta

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/formgenome
# For local development, you can use SQLite:
# DATABASE_URL=sqlite:///formgenome.db

# =============================================================================
# Application Configuration
# =============================================================================
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your_secret_key_here

# Port configuration
PORT=8080

# =============================================================================
# PDF Processing Configuration
# =============================================================================
# Maximum PDF file size in MB
MAX_PDF_SIZE_MB=50

# PDF fetch timeout in seconds
PDF_FETCH_TIMEOUT=30

# =============================================================================
# Crawler Configuration
# =============================================================================
# Maximum crawl depth
MAX_CRAWL_DEPTH=3

# Maximum PDFs to discover per domain
MAX_PDFS_PER_DOMAIN=1000

# Crawler delay between requests (seconds)
CRAWLER_DELAY=1.0

# =============================================================================
# Alert Configuration (Optional)
# =============================================================================
# SMS Alerts via Twilio (uncomment to enable)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890
# ALERT_PHONE_NUMBER=+1234567890

# Email Alerts (uncomment to enable)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=alerts@example.com

# =============================================================================
# Monitoring & Logging
# =============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Enable detailed LLM logging
LLM_DEBUG=false

# =============================================================================
# Google Cloud Configuration (for Cloud Run deployment)
# =============================================================================
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =============================================================================
# Storage Configuration
# =============================================================================
# Local file storage path
STORAGE_PATH=./data/pdfs

# Google Cloud Storage (optional)
# GCS_BUCKET=your-bucket-name
# GCS_PDF_PREFIX=pdfs/

# =============================================================================
# Feature Flags
# =============================================================================
# Enable vision analysis for scanned PDFs
ENABLE_VISION_ANALYSIS=false

# Enable form complexity analysis
ENABLE_COMPLEXITY_ANALYSIS=true

# Enable title normalization
ENABLE_TITLE_NORMALIZATION=true

# =============================================================================
# Rate Limiting
# =============================================================================
# LLM rate limit (requests per minute)
LLM_RATE_LIMIT=60

# API rate limit (requests per minute per IP)
API_RATE_LIMIT=100

# =============================================================================
# Cache Configuration
# =============================================================================
# Enable response caching
ENABLE_CACHE=true

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# Development Tools
# =============================================================================
# Enable hot reload in development
FLASK_RELOAD=true

# Enable profiling
ENABLE_PROFILING=false

# Enable request logging
LOG_REQUESTS=true
