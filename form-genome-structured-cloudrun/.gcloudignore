# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

.gcloudignore
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test files
test_*.py
*_test.py
tests/

# Documentation
*.md
docs/

# Database (use Cloud SQL or Firestore in production)
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Environment files (will be set in Cloud Run)
.env
.env.local
.env.*.local

# Temporary files
tmp/
temp/
*.tmp
